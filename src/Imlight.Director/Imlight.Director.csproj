<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- CLASSIC: measured 2026-10-04 (playbot-reports/server-perf.md, 16 bots + 32 ambient wizards, 4 cores): workstation
         concurrent GC paused at most 6.9 ms at a time with the smallest heap; Server GC (with or without
         GCConserveMemory) cut total pause time but its single pauses reached 38-42 ms and it used 0.5-1 GB more.
         Spelled out so a runtime default change cannot switch it silently. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="config\akka.conf" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Config\akka.conf">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Content\serverdata" />
    <Content Include="Config\Imlight.ini">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Remove="Certificates\base" />
    <Content Include="Certificates\base">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Remove="Config\Imlight.ini" />
    <Content Include="spiraldb-cache\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Akka" Version="1.5.33" />
    <PackageReference Include="Akka.Logger.Serilog" Version="1.5.25" />
    <PackageReference Include="Akka.Remote" Version="1.5.33" />
    <PackageReference Include="Serilog" Version="2.12.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Imlight.Common\Imlight.Common.csproj" />
    <ProjectReference Include="..\Imlight.CoreLib\Imlight.CoreLib.csproj" />
  </ItemGroup>

</Project>
