<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>


  <!-- Production-server tests require private generated types. Pure rules remain buildable in public CI. -->
  <ItemGroup>
    <_PrivateTypes Include="../../submodule/Imcodec/src/Imcodec.ObjectProperty/GeneratorInput/*.json" />
    <_PrivateMessages Include="../../submodule/Imcodec/src/Imcodec.MessageLayer/GeneratorInput/*Messages*.xml" />
    <ServerIntegrationTest Include="ArcFinalReviewTests.cs" />
    <ServerIntegrationTest Include="EnhancedProtocolTests.cs" />
    <ServerIntegrationTest Include="ExcludedEnemyDespawnTests.cs" />
    <ServerIntegrationTest Include="BadgeRulesTests.cs" />
    <ServerIntegrationTest Include="C6ServerGapTests.cs" />
    <ServerIntegrationTest Include="ClassicCinematicTests.cs" />
    <ServerIntegrationTest Include="ClassicDeckRegressionTests.cs" />
    <ServerIntegrationTest Include="ClassicEnchantmentPacketTests.cs" />
    <ServerIntegrationTest Include="ClassicMinionOwnershipTests.cs" />
    <ServerIntegrationTest Include="OwnedMinionControlTests.cs" />
    <ServerIntegrationTest Include="OwnedMinionDuelTests.cs" />
    <ServerIntegrationTest Include="MonstrologyConcurrencyTests.cs" />
    <ServerIntegrationTest Include="ClassicDialogCameraTests.cs" />
    <ServerIntegrationTest Include="ClassicLaterObjectsTests.cs" />
    <ServerIntegrationTest Include="CrownShopCatalogTests.cs" />
    <ServerIntegrationTest Include="GoldenBattleTests.cs" />
    <ServerIntegrationTest Include="QuestOfferOrderTests.cs" />
    <ServerIntegrationTest Include="ClassicZoneWadsTests.cs" />
    <ServerIntegrationTest Include="MonstrologyTests.cs" />
    <ServerIntegrationTest Include="MonstrologyMetadataTests.cs" />
    <ServerIntegrationTest Include="MonstrologyTomeCodecTests.cs" />
    <ServerIntegrationTest Include="MonstrologyTransactionTests.cs" />
    <ServerIntegrationTest Include="MonstrologyPendingExtractionTests.cs" />
    <ServerIntegrationTest Include="MonstrologySessionPolicyTests.cs" />
    <ServerIntegrationTest Include="MonstrologyCastGuardTests.cs" />
    <ServerIntegrationTest Include="ClassicMinionAITargetTests.cs" />
    <ServerIntegrationTest Include="CraftingProtocolEvidenceTests.cs" />
    <ServerIntegrationTest Include="ClassicUtilityCombatTests.cs" />
    <ServerIntegrationTest Include="CombatRegressionTests.cs" />
    <ServerIntegrationTest Include="EquipmentAttachConcurrencyTests.cs" />
    <ServerIntegrationTest Include="PowerPipRulesTests.cs" />
    <ServerIntegrationTest Include="SharedPlayerStateRaceTests.cs" />
    <ServerIntegrationTest Include="SpellMechanicsTests.cs" />
    <ServerIntegrationTest Include="TcpListenerLifecycleTests.cs" />
    <ServerIntegrationTest Include="TriggerObjectResultTests.cs" />
    <ServerIntegrationTest Include="DoorLightRuntimeTests.cs" />
    <ServerIntegrationTest Include="LegacyDoorRuntimeTests.cs" />
    <ServerIntegrationTest Include="ZoneMarkerLifecycleTests.cs" />
  </ItemGroup>
  <PropertyGroup>
    <_TypeInputPath>$(MSBuildThisFileDirectory)../../submodule/Imcodec/src/Imcodec.ObjectProperty/GeneratorInput</_TypeInputPath>
    <_MessageInputPath>$(MSBuildThisFileDirectory)../../submodule/Imcodec/src/Imcodec.MessageLayer/GeneratorInput</_MessageInputPath>
    <_TypeInputFiles Condition="Exists('$(_TypeInputPath)')">$([System.IO.Directory]::GetFiles('$(_TypeInputPath)', '*.json'))</_TypeInputFiles>
    <_MessageInputFiles Condition="Exists('$(_MessageInputPath)')">$([System.IO.Directory]::GetFiles('$(_MessageInputPath)', '*Messages*.xml'))</_MessageInputFiles>
    <W101CServerIntegrationTests Condition="'$(W101CServerIntegrationTests)' == '' and '$(_TypeInputFiles)' != '' and '$(_MessageInputFiles)' != ''">true</W101CServerIntegrationTests>
    <W101CServerIntegrationTests Condition="'$(W101CServerIntegrationTests)' == ''">false</W101CServerIntegrationTests>
  </PropertyGroup>
  <ItemGroup Condition="'$(W101CServerIntegrationTests)' != 'true'">
    <Compile Remove="@(ServerIntegrationTest)" />
  </ItemGroup>
  <Target Name="ReportServerTestMode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(W101CServerIntegrationTests)' == 'true' and ('@(_PrivateTypes)' == '' or '@(_PrivateMessages)' == '')"
           Text="Server integration tests require locally staged type and message inputs. Public CI must use W101CServerIntegrationTests=false." />
    <Message Importance="high" Text="Server integration tests enabled: $(W101CServerIntegrationTests). Pure rules tests always run." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Imlight.Classic\Imlight.Classic.csproj" />
    <!-- CLASSIC: the server-side race, cinematic and badge tests use CoreLib's own types. -->
    <ProjectReference Include="..\..\src\Imlight.CoreLib\Imlight.CoreLib.csproj" Condition="'$(W101CServerIntegrationTests)' == 'true'" />
  </ItemGroup>

</Project>
