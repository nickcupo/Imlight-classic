+using Imcodec.IO;
+
+namespace Imcodec.Test.IOTest;
+
+public class BitStringTest {
+
+    public static TheoryData<string> Strings => new() {
+        string.Empty,
+        "a",
+        "Wizard City",
+        new string('x', 127),
+        new string('y', 128),
+        new string('z', 1000),
+    };
+
+    private static BitWriter Writer(bool compact) {
+        var writer = new BitWriter();
+        if (compact) {
+            writer.WithCompactLengths();
+        }
+
+        return writer;
+    }
+
+    private static BitReader Reader(byte[] data, bool compact) {
+        var reader = new BitReader(data);
+        if (compact) {
+            reader.WithCompactLengths();
+        }
+
+        return reader;
+    }
+
+    [Theory]
+    [MemberData(nameof(Strings))]
+    public void WriteString_Compact_RoundTrips(string value) {
+        // Arrange. A trailing dword proves the reader ends where the writer did.
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteString(value);
+        writer.WriteUInt32(0xDEADBEEF);
+        var reader = Reader(writer.GetData(), compact: true);
+
+        // Assert
+        Assert.Equal(value, (string) reader.ReadString());
+        Assert.Equal(0xDEADBEEF, reader.ReadUInt32());
+    }
+
+    [Theory]
+    [MemberData(nameof(Strings))]
+    public void WriteString_Verbose_RoundTrips(string value) {
+        // Arrange
+        var writer = Writer(compact: false);
+
+        // Act
+        writer.WriteString(value);
+        writer.WriteUInt32(0xDEADBEEF);
+        var reader = Reader(writer.GetData(), compact: false);
+
+        // Assert
+        Assert.Equal(value, (string) reader.ReadString());
+        Assert.Equal(0xDEADBEEF, reader.ReadUInt32());
+    }
+
+    [Theory]
+    [MemberData(nameof(Strings))]
+    [InlineData("Ünïcødé ☃")]
+    public void WriteWString_Compact_RoundTrips(string value) {
+        // Arrange
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteWString(value);
+        writer.WriteUInt32(0xDEADBEEF);
+        var reader = Reader(writer.GetData(), compact: true);
+
+        // Assert
+        Assert.Equal(value, reader.ReadWString());
+        Assert.Equal(0xDEADBEEF, reader.ReadUInt32());
+    }
+
+    [Theory]
+    [MemberData(nameof(Strings))]
+    [InlineData("Ünïcødé ☃")]
+    public void WriteWString_Verbose_RoundTrips(string value) {
+        // Arrange
+        var writer = Writer(compact: false);
+
+        // Act
+        writer.WriteWString(value);
+        writer.WriteUInt32(0xDEADBEEF);
+        var reader = Reader(writer.GetData(), compact: false);
+
+        // Assert
+        Assert.Equal(value, reader.ReadWString());
+        Assert.Equal(0xDEADBEEF, reader.ReadUInt32());
+    }
+
+    [Fact]
+    public void WriteString_Compact_SmallPrefixIsOneByte() {
+        // Arrange. Flag bit clear, then the length in 7 bits, LSB first.
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteString("abc");
+        var data = writer.GetData();
+
+        // Assert
+        Assert.Equal(new byte[] { 3 << 1, (byte) 'a', (byte) 'b', (byte) 'c' }, data);
+    }
+
+    [Fact]
+    public void WriteString_Compact_LargePrefixIsTwoBytes() {
+        // Arrange. Flag bit set, then the length in 15 bits, LSB first.
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteString(new string('q', 300));
+        var data = writer.GetData();
+
+        // Assert
+        Assert.Equal(302, data.Length);
+        Assert.Equal((300 << 1) | 1, data[0] | (data[1] << 8));
+    }
+
+    [Fact]
+    public void WriteString_Compact_EmptyStillByteAligns() {
+        // Arrange. BitReader.ReadString always byte-aligns after the length,
+        // even for an empty string, so the bit after it starts a new byte.
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteBit(true);
+        writer.WriteString(string.Empty);
+        writer.WriteBit(true);
+        var data = writer.GetData();
+        var reader = Reader(data, compact: true);
+
+        // Assert
+        Assert.Equal(new byte[] { 0x01, 0x00, 0x01 }, data);
+        Assert.True(reader.ReadBit());
+        Assert.Equal(string.Empty, (string) reader.ReadString());
+        Assert.True(reader.ReadBit());
+    }
+
+    [Fact]
+    public void WriteWString_Compact_EmptyDoesNotByteAlign() {
+        // Arrange. BitReader.ReadWString returns on an empty string without
+        // byte-aligning, so the next bit shares the length's last byte.
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteBit(true);
+        writer.WriteWString(string.Empty);
+        writer.WriteBit(true);
+        var data = writer.GetData();
+        var reader = Reader(data, compact: true);
+
+        // Assert
+        Assert.Equal(new byte[] { 0x01, 0x02 }, data);
+        Assert.True(reader.ReadBit());
+        Assert.Equal(string.Empty, reader.ReadWString());
+        Assert.True(reader.ReadBit());
+    }
+
+    [Fact]
+    public void WriteString_Compact_AfterBits_RoundTrips() {
+        // Arrange. Mirrors a bit-packed property followed by a string.
+        var writer = Writer(compact: true);
+
+        // Act
+        writer.WriteBits((byte) 0x5, 3);
+        writer.WriteString("Ravenwood");
+        writer.WriteWString("Unicorn Way");
+        var reader = Reader(writer.GetData(), compact: true);
+
+        // Assert
+        Assert.Equal((byte) 0x5, reader.ReadBits<byte>(3));
+        Assert.Equal("Ravenwood", (string) reader.ReadString());
+        Assert.Equal("Unicorn Way", reader.ReadWString());
+    }
+
+}
